# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — Project Settings > API > service_role.
# ⚠️ SERVER-ONLY SECRET. Bypasses Row Level Security entirely. Never expose to the
# browser, never prefix with NEXT_PUBLIC_. Only used to manage the Gemini key pool
# (gemini_api_key_pool table) and by scripts/add-gemini-key.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — free API key at https://aistudio.google.com/apikey
# Fallback used only if the gemini_api_key_pool table is empty or every pooled key is
# exhausted. Add pooled keys instead via: node scripts/add-gemini-key.mjs <api-key> [label]
GEMINI_API_KEY=

# Optional: max stories (= AI calls) a user can generate per day
MAX_STORIES_PER_DAY=10

# Optional: max chat messages a user can send per day (using the shared server key)
MAX_CHAT_MESSAGES_PER_DAY=30

# Optional: max writing submissions a user can get AI feedback on per day
MAX_WRITINGS_PER_DAY=10

# Optional: max "scan vocabulary from a photo" calls a user can make per day
MAX_VOCAB_SCANS_PER_DAY=10

# Optional: max "grade my English translation" calls a user can make per day
MAX_GRAMMAR_CHECKS_PER_DAY=20

# Any random long string — used to encrypt per-user Gemini API keys before storing them.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=
